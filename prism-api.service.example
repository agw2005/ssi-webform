# 1. Move this file inside `/etc/systemd/system`
# 2. Scan for unit changes with `sudo systemctl daemon-reload`
# 3. Run and ensure it starts on reboot `sudo systemctl enable prism-api`

[Unit]
Description=Deno Oak Web Server for PRISM
Aftter=network.target

[Service]
User=administrator
Group=adm
WorkingDirectory=location-of-server-bundle
ExecStart=location-of-server-executable
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target